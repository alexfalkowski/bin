#!/usr/bin/env bash
# Commit staged and tracked changes using the Makefile-provided message parts.

set -eo pipefail

if [[ -z ${msg//[[:space:]]/} ]]; then
  printf 'bin: set msg to a non-empty commit subject\n' >&2
  exit 1
fi

file="$(mktemp)"
trap 'rm -f "$file"' EXIT

printf '%s\n\n' "${PREFIX:-} ${msg:-}" > "$file"

if [[ -n ${desc_file:-} ]]; then
  cat "$desc_file"
else
  printf '%s\n' "${desc:-}"
fi >> "$file"

git commit -a -F "$file"
